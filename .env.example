# ==============================================================================
# Backtrace Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.production and fill in your production credentials.
# In ENVIRONMENT=production, all required credentials must be present and valid.
# ==============================================================================

# Core Environment
ENVIRONMENT=production
APP_NAME=Backtrace
DEBUG=false
HOST=0.0.0.0
PORT=8000
ENABLE_PUBLIC_LEADERBOARD=false

# PostgreSQL Database (Docker internal network connection or SQLite fallback)
POSTGRES_USER=backtrace_admin
POSTGRES_PASSWORD=replace_with_a_secure_random_postgres_password_32_bytes_min
POSTGRES_DB=backtrace
DATABASE_URL=postgresql+psycopg2://backtrace_admin:replace_with_a_secure_random_postgres_password_32_bytes_min@postgres:5432/backtrace
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Authentication & JWT Secrets (Must be at least 32 characters, non-default)
JWT_SECRET_KEY=replace_with_a_secure_random_production_secret_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# GitHub OAuth Application (From GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=https://api.backtrace.dev/auth/github/callback

# Stripe Billing & Quota (From Stripe Dashboard -> Developers -> API Keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_your_webhook_secret
STRIPE_PRICE_ID_PRO=price_placeholder_replace_with_your_stripe_price_id
STRIPE_SUCCESS_URL=https://app.backtrace.dev/dashboard?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://app.backtrace.dev/dashboard
FREE_TIER_MONTHLY_LIMIT=5

# Monitoring & Error Tracking (Optional but recommended)
SENTRY_DSN=https://example_key@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Product Analytics (Optional but recommended)
POSTHOG_API_KEY=phc_placeholder_replace_with_your_posthog_key
POSTHOG_HOST=https://app.posthog.com

# Distributed Rate Limiting & Execution Infrastructure
REDIS_PASSWORD=replace_with_a_secure_random_redis_password_32_bytes_min
REDIS_URL=redis://:replace_with_a_secure_random_redis_password_32_bytes_min@redis:6379/0
RATE_LIMIT_CIRCUIT_BREAKER_THRESHOLD=5
RATE_LIMIT_REDIS_TIMEOUT=1.5
PISTON_URL=http://disabled:2000
